local HttpService = game:GetService("HttpService")

local ExternalAPI = {
	EmotesData = {},
	Loaded = false
}

function ExternalAPI.LoadData()
	local Success, Result = pcall(function()
		return game:HttpGetAsync("https://raw.githubusercontent.com/DRYF-1/Roblox-Emote/refs/heads/main/EmoteSniper.json")
	end)

	if not Success or not Result then return end

	local Ok, Data = pcall(function() return HttpService:JSONDecode(Result) end)
	if not Ok or type(Data) ~= "table" then return end

	if Data.data then Data = Data.data elseif Data.Emotes then Data = Data.Emotes end

	local FinalEmotes = {}
	local LoadedEmotes = {}

	local function AddEmote(Name, Id)
		if not (Name and Id) then return end
		Id = tonumber(Id)
		if not Id then return end
		if LoadedEmotes[Id] then return end
		LoadedEmotes[Id] = true

		Name = tostring(Name)
		table.insert(FinalEmotes, {
			name = Name,
			lowerName = string.lower(Name),
			id = Id,
			icon = "rbxthumb://type=Asset&id=" .. tostring(Id) .. "&w=150&h=150",
			lastupdated = os.time(),
		})
	end

	for _, Emote in pairs(Data) do
		if type(Emote) == "table" then
			local Name = Emote.Name or Emote.name
			local Id = Emote.Id or Emote.id or Emote.AssetId
			if Name and Id then AddEmote(Name, Id) end
		end
	end

	AddEmote("Arm Wave", 5915773155)
	AddEmote("Head Banging", 5915779725)
	AddEmote("Face Calisthenics", 9830731012)

	ExternalAPI.EmotesData = FinalEmotes
	ExternalAPI.Loaded = true
end

function ExternalAPI.GetPage(Page, PerPage, Query, SortMode, FavSet)
	if not ExternalAPI.Loaded then return {}, 1, 1 end

	local Filtered = ExternalAPI.EmotesData

	if Query and Query ~= "" then
		Filtered = {}
		for i = 1, #ExternalAPI.EmotesData do
			if ExternalAPI.EmotesData[i].lowerName:find(Query, 1, true) then
				table.insert(Filtered, ExternalAPI.EmotesData[i])
			end
		end
	end

	local DisplayList = {}
	for i = 1, #Filtered do DisplayList[i] = Filtered[i] end

	table.sort(DisplayList, function(a, b)
		local Af = FavSet[a.id] == true
		local Bf = FavSet[b.id] == true
		if Af ~= Bf then return Af and not Bf end

		if SortMode == "recentfirst" then return (a.lastupdated or 0) > (b.lastupdated or 0)
		elseif SortMode == "recentlast" then return (a.lastupdated or 0) < (b.lastupdated or 0)
		elseif SortMode == "alphabeticfirst" then return a.lowerName < b.lowerName
		elseif SortMode == "alphabeticlast" then return a.lowerName > b.lowerName
		end
		return a.lowerName < b.lowerName
	end)

	local TotalPages = math.max(1, math.ceil(#DisplayList / PerPage))
	if Page < 1 then Page = 1 end
	if Page > TotalPages then Page = TotalPages end

	local StartIndex = (Page - 1) * PerPage + 1
	local EndIndex = math.min(StartIndex + PerPage - 1, #DisplayList)
	
	local PageResult = {}
	for i = StartIndex, EndIndex do
		table.insert(PageResult, DisplayList[i])
	end

	return PageResult, TotalPages, Page, StartIndex
end

return ExternalAPI
